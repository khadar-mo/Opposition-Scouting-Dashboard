# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# OPTIONAL. Everything in the dashboard works without this; setting it only
# switches on the experimental "Ask" tab (grounded opponent Q&A).
# Get a key from https://console.anthropic.com/settings/keys — this is a
# pay-as-you-go API key, separate from any Claude subscription.
ANTHROPIC_API_KEY=

# Only needed if you run Postgres somewhere other than the docker-compose
# default (postgresql://scout:scout@localhost:5432/scouting).
# DATABASE_URL=
